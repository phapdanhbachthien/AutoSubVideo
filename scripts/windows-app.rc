// Preserve the Vietnamese product and company names in version resources.
#pragma code_page(65001)
1 ICON "assets/app-icon.ico"
1 VERSIONINFO
FILEVERSION 0,3,1,0
PRODUCTVERSION 0,3,1,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Bách Thiện Audio\0"
      VALUE "FileDescription", "Thiện Media Player // Cyber Edition\0"
      VALUE "FileVersion", "0.3.1\0"
      VALUE "InternalName", "ThienMediaPlayer\0"
      VALUE "OriginalFilename", "ThienMediaPlayer.exe\0"
      VALUE "ProductName", "Thiện Media Player\0"
      VALUE "ProductVersion", "0.3.1\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
